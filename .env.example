# Copie este arquivo para ".env" e cole seu AppID do sandbox da Woovi.
#   cp .env.example .env
#
# O AppID sai em: painel Woovi > API/Plugins > Nova API/Plugin > tipo "API"
WOOVI_APP_ID=cole_seu_appid_aqui

# Ambiente de testes. Para produção seria https://api.woovi.com
WOOVI_BASE_URL=https://api.woovi-sandbox.com
